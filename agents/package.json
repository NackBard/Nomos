{
  "name": "nomos-agents",
  "displayName": "Nomos Agents",
  "description": "%description%",
  "version": "0.1.0",
  "publisher": "honestarchitector",
  "repository": {
    "type": "git",
    "url": "https://github.com/NackBard/Nomos.git"
  },
  "private": true,
  "license": "MIT",
  "icon": "media/icon.png",
  "engines": {
    "vscode": "^1.101.0"
  },
  "categories": [
    "AI",
    "Chat",
    "Linters"
  ],
  "extensionDependencies": [
    "honestarchitector.nomos"
  ],
  "main": "./out/extension.js",
  "bin": {
    "nomos-mcp": "./out/mcp/server.js"
  },
  "activationEvents": [],
  "contributes": {
    "chatParticipants": [
      {
        "id": "nomos-agents.review",
        "name": "nomos-review",
        "fullName": "Nomos Review",
        "description": "%participant.review%",
        "isSticky": true,
        "commands": [
          {
            "name": "changes",
            "description": "%participant.command.changes%"
          },
          {
            "name": "all",
            "description": "%participant.command.all%"
          }
        ]
      },
      {
        "id": "nomos-agents.performance",
        "name": "nomos-perf",
        "fullName": "Nomos Performance",
        "description": "%participant.performance%",
        "isSticky": true,
        "commands": [
          {
            "name": "changes",
            "description": "%participant.command.changes%"
          },
          {
            "name": "all",
            "description": "%participant.command.all%"
          }
        ]
      }
    ],
    "mcpServerDefinitionProviders": [
      {
        "id": "nomos-agents.mcp",
        "label": "Nomos"
      }
    ],
    "commands": [
      {
        "command": "nomosAgents.review",
        "title": "%command.review%",
        "category": "Nomos"
      },
      {
        "command": "nomosAgents.performance",
        "title": "%command.performance%",
        "category": "Nomos"
      },
      {
        "command": "nomosAgents.setAnthropicKey",
        "title": "%command.setAnthropicKey%",
        "category": "Nomos"
      },
      {
        "command": "nomosAgents.clearAnthropicKey",
        "title": "%command.clearAnthropicKey%",
        "category": "Nomos"
      }
    ],
    "configuration": {
      "title": "Nomos Agents",
      "properties": {
        "nomosAgents.provider": {
          "type": "string",
          "enum": [
            "vscode-lm",
            "anthropic"
          ],
          "enumDescriptions": [
            "%config.provider.vscodeLm%",
            "%config.provider.anthropic%"
          ],
          "default": "vscode-lm",
          "description": "%config.provider%"
        },
        "nomosAgents.review.scope": {
          "type": "string",
          "enum": [
            "changes",
            "all"
          ],
          "enumDescriptions": [
            "%config.scope.changes%",
            "%config.scope.all%"
          ],
          "default": "changes",
          "description": "%config.review.scope%"
        },
        "nomosAgents.performance.scope": {
          "type": "string",
          "enum": [
            "changes",
            "all"
          ],
          "enumDescriptions": [
            "%config.scope.changes%",
            "%config.scope.all%"
          ],
          "default": "all",
          "description": "%config.performance.scope%"
        },
        "nomosAgents.base": {
          "type": "string",
          "default": "",
          "description": "%config.base%"
        },
        "nomosAgents.contextCharacters": {
          "type": "integer",
          "minimum": 10000,
          "default": 200000,
          "description": "%config.contextCharacters%"
        },
        "nomosAgents.vscodeLm.family": {
          "type": "string",
          "default": "",
          "description": "%config.vscodeLm.family%"
        },
        "nomosAgents.anthropic.model": {
          "type": "string",
          "default": "claude-opus-5-5",
          "description": "%config.anthropic.model%"
        },
        "nomosAgents.anthropic.effort": {
          "type": "string",
          "enum": [
            "low",
            "medium",
            "high",
            "xhigh",
            "max"
          ],
          "default": "high",
          "description": "%config.anthropic.effort%"
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p .",
    "vscode:prepublish": "npm run compile",
    "test": "npm run compile && node --test \"out/test/**/*.test.js\"",
    "package": "node -e \"require('fs').mkdirSync('dist',{recursive:true})\" && vsce package --out dist/"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "1.7.0"
  },
  "devDependencies": {
    "@types/node": "24.3.0",
    "@types/vscode": "1.101.0",
    "@vscode/vsce": "4.0.0",
    "typescript": "5.9.2"
  },
  "l10n": "./l10n"
}
