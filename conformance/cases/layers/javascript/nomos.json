{
  "schemaVersion": "1.0.0",
  "analyzers": [
    {
      "language": "javascript",
      "command": [
        "nomos-typescript"
      ]
    }
  ],
  "layers": [
    {
      "name": "Domain",
      "patterns": [
        "domain/*"
      ],
      "mayDependOn": []
    },
    {
      "name": "Services",
      "patterns": [
        "services/*"
      ],
      "mayDependOn": [
        "Domain"
      ]
    },
    {
      "name": "Web",
      "patterns": [
        "web/*"
      ],
      "mayDependOn": [
        "Services"
      ]
    }
  ]
}
