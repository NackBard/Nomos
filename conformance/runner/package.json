{
  "name": "nomos-conformance-runner",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Conformance harness for Nomos analyzers (ROADMAP stage 1).",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "validate": "node src/cli.ts validate",
    "run": "node src/cli.ts run",
    "test": "node --test \"src/**/*.test.ts\"",
    "csharp": "node src/cli.ts run --analyzer \"csharp=dotnet analyzers/csharp/src/Nomos.Analyzer.CSharp/bin/Debug/net10.0/nomos-csharp.dll\"",
    "fetch-sarif-schema": "node src/fetch-sarif-schema.ts",
    "selftest": "node src/cli.ts run --analyzer \"csharp=node conformance/runner/src/echo-analyzer.ts\"",
    "rules-doc": "node src/write-rules-doc.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "ajv": "8.17.1",
    "ajv-draft-04": "1.0.0",
    "yaml": "2.8.1"
  },
  "devDependencies": {
    "@types/node": "24.3.0",
    "typescript": "5.9.2"
  }
}
