{
  "name": "nomos-typescript",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Nomos analyzer for TypeScript and JavaScript on the TypeScript Compiler API (D-055).",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "start": "node src/main.ts",
    "test": "node --test \"src/**/*.test.ts\"",
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json"
  },
  "dependencies": {
    "typescript": "5.9.2"
  },
  "devDependencies": {
    "@types/node": "24.3.0"
  }
}
