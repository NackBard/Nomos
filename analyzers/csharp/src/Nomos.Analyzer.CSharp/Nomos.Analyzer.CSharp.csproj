<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>nomos-csharp</AssemblyName>
    <RootNamespace>Nomos.Analyzer.CSharp</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="YamlDotNet" />
  </ItemGroup>
  <ItemGroup>
    <!-- The rules are data (spec/rules): titles, descriptions and rationale are read from here, not duplicated in code. -->
    <EmbeddedResource Include="..\..\..\..\spec\rules\*.yaml" LogicalName="spec/rules/%(Filename)%(Extension)" />
    <EmbeddedResource Include="..\..\..\..\spec\practices.yaml" LogicalName="spec/practices.yaml" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Nomos.Core\Nomos.Core.csproj" />
    <ProjectReference Include="..\Nomos.Facts\Nomos.Facts.csproj" />
    <ProjectReference Include="..\Nomos.Languages.CSharp\Nomos.Languages.CSharp.csproj" />
    <ProjectReference Include="..\Nomos.Analyzers.Principles\Nomos.Analyzers.Principles.csproj" />
    <ProjectReference Include="..\Nomos.Analyzers.CleanCode\Nomos.Analyzers.CleanCode.csproj" />
    <ProjectReference Include="..\Nomos.Analyzers.Paradigms\Nomos.Analyzers.Paradigms.csproj" />
    <ProjectReference Include="..\Nomos.Analyzers.Algorithms\Nomos.Analyzers.Algorithms.csproj" />
    <ProjectReference Include="..\Nomos.Analyzers.Design\Nomos.Analyzers.Design.csproj" />
    <ProjectReference Include="..\Nomos.Analyzers.Patterns\Nomos.Analyzers.Patterns.csproj" />
    <ProjectReference Include="..\Nomos.Analyzers.Maintainability\Nomos.Analyzers.Maintainability.csproj" />
    <ProjectReference Include="..\Nomos.Analyzers.Security\Nomos.Analyzers.Security.csproj" />
  </ItemGroup>
</Project>
