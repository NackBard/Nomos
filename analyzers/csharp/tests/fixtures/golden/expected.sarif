{
  "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
  "version": "2.1.0",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "nomos-csharp",
          "version": "0.1.0",
          "semanticVersion": "0.1.0",
          "rules": [
            {
              "id": "ALG001",
              "name": "Time complexity estimate",
              "shortDescription": {
                "text": "Estimates growth from loop nesting, known linear calls, recursion shape and project callees."
              },
              "fullDescription": {
                "text": "Always an estimate; input sizes are unknown."
              },
              "defaultConfiguration": {
                "level": "warning"
              },
              "properties": {
                "category": "Algorithms",
                "paradigms": []
              }
            },
            {
              "id": "ALG002",
              "name": "Quadratic pattern",
              "shortDescription": {
                "text": "List searches, front insertions and string concatenation inside loops."
              },
              "fullDescription": {
                "text": "Typical sources of accidental quadratic time."
              },
              "defaultConfiguration": {
                "level": "warning"
              },
              "properties": {
                "category": "Algorithms",
                "paradigms": []
              }
            },
            {
              "id": "ALG003",
              "name": "Allocation in hot loop",
              "shortDescription": {
                "text": "Materializing calls in loops; object creation or closures in nested loops."
              },
              "fullDescription": {
                "text": "Allocation pressure in frequently executed code."
              },
              "defaultConfiguration": {
                "level": "warning"
              },
              "properties": {
                "category": "Algorithms",
                "paradigms": []
              }
            },
            {
              "id": "ALG004",
              "name": "Space complexity estimate",
              "shortDescription": {
                "text": "Collections growing in loops, arrays of non-constant size, recursion depth."
              },
              "fullDescription": {
                "text": "Always an estimate; input sizes are unknown."
              },
              "defaultConfiguration": {
                "level": "warning"
              },
              "properties": {
                "category": "Algorithms",
                "paradigms": []
              }
            },
            {
              "id": "CC001",
              "name": "Long method",
              "shortDescription": {
                "text": "Source lines of a callable."
              },
              "fullDescription": {
                "text": "Long callables are harder to read and test."
              },
              "defaultConfiguration": {
                "level": "warning"
              },
              "properties": {
                "category": "CleanCode",
                "paradigms": [
                  "functional",
                  "oop",
                  "structural"
                ]
              }
            },
            {
              "id": "CC002",
              "name": "Large class",
              "shortDescription": {
                "text": "Lines and members of a type, over all of its parts."
              },
              "fullDescription": {
                "text": "A large type tends to collect several responsibilities."
              },
              "defaultConfiguration": {
                "level": "warning"
              },
              "properties": {
                "category": "CleanCode",
                "paradigms": [
                  "oop"
                ]
              }
            },
            {
              "id": "CC003",
              "name": "Too many parameters",
              "shortDescription": {
                "text": "Parameter count of a callable; constructors have a separate limit because of dependency injection."
              },
              "fullDescription": {
                "text": "Long parameter lists are hard to call correctly."
              },
              "defaultConfiguration": {
                "level": "warning"
              },
              "properties": {
                "category": "CleanCode",
                "paradigms": [
                  "functional",
                  "oop",
                  "structural"
                ]
              }
            },
            {
              "id": "CC004",
              "name": "Deep nesting",
              "shortDescription": {
                "text": "Nesting depth of branches, loops and guarded blocks; else-if chains stay flat."
              },
              "fullDescription": {
                "text": "Each level adds a condition the reader must hold in mind."
              },
              "defaultConfiguration": {
                "level": "warning"
              },
              "properties": {
                "category": "CleanCode",
                "paradigms": [
                  "functional",
                  "oop",
                  "structural"
                ]
              }
            },
            {
              "id": "CC006",
              "name": "Placeholders",
              "shortDescription": {
                "text": "TODO, FIXME, HACK and XXX comments, and bodies that only throw not-implemented."
              },
              "fullDescription": {
                "text": "Marks unfinished work."
              },
              "defaultConfiguration": {
                "level": "warning"
              },
              "properties": {
                "category": "CleanCode",
                "paradigms": [
                  "functional",
                  "oop",
                  "structural"
                ]
              }
            },
            {
              "id": "CC007",
              "name": "Dead code",
              "shortDescription": {
                "text": "Unreachable statements, unused locals, private members nothing refers to."
              },
              "fullDescription": {
                "text": "Code that never runs still has to be read."
              },
              "defaultConfiguration": {
                "level": "warning"
              },
              "properties": {
                "category": "CleanCode",
                "paradigms": [
                  "functional",
                  "oop",
                  "structural"
                ]
              }
            },
            {
              "id": "CC008",
              "name": "Commented-out code",
              "shortDescription": {
                "text": "Line comments that end like statements."
              },
              "fullDescription": {
                "text": "Version control keeps history; disabled code is noise."
              },
              "defaultConfiguration": {
                "level": "warning"
              },
              "properties": {
                "category": "CleanCode",
                "paradigms": [
                  "functional",
                  "oop",
                  "structural"
                ]
              }
            },
            {
              "id": "CC009",
              "name": "Empty catch",
              "shortDescription": {
                "text": "A catch block with no statements and no comment."
              },
              "fullDescription": {
                "text": "The failure is silently discarded."
              },
              "defaultConfiguration": {
                "level": "warning"
              },
              "properties": {
                "category": "CleanCode",
                "paradigms": [
                  "functional",
                  "oop",
                  "structural"
                ]
              }
            },
            {
              "id": "CS.NAM001",
              "name": "Naming conventions",
              "shortDescription": {
                "text": "Types, methods and properties in PascalCase, interfaces start with I, parameters in camelCase; one-letter parameters of public methods."
              },
              "fullDescription": {
                "text": "Departures from .NET conventions slow reading. Formerly CC005."
              },
              "defaultConfiguration": {
                "level": "note"
              },
              "properties": {
                "category": "CleanCode",
                "paradigms": [
                  "functional",
                  "oop",
                  "structural"
                ]
              }
            },
            {
              "id": "DSN001",
              "name": "Main sequence distance",
              "shortDescription": {
                "text": "Per module Ca, Ce, instability I, abstractness A and distance D (spec/metrics.md)."
              },
              "fullDescription": {
                "text": "D near 1 means a module is rigid or useless."
              },
              "defaultConfiguration": {
                "level": "warning"
              },
              "properties": {
                "category": "Design",
                "paradigms": []
              }
            },
            {
              "id": "DSN002",
              "name": "Dependency cycles",
              "shortDescription": {
                "text": "Strongly connected components (Tarjan) in the module graph and the type graph."
              },
              "fullDescription": {
                "text": "Members of a cycle cannot be understood or changed separately."
              },
              "defaultConfiguration": {
                "level": "warning"
              },
              "properties": {
                "category": "Design",
                "paradigms": []
              }
            },
            {
              "id": "DSN003",
              "name": "Layer violations",
              "shortDescription": {
                "text": "Dependencies on layers that the configuration does not allow."
              },
              "fullDescription": {
                "text": "Layering was declared by the team and is being bypassed."
              },
              "defaultConfiguration": {
                "level": "warning"
              },
              "properties": {
                "category": "Design",
                "paradigms": []
              }
            },
            {
              "id": "DSN004",
              "name": "God class",
              "shortDescription": {
                "text": "Lanza and Marinescu detection strategy, high WMC, high ATFD, low TCC."
              },
              "fullDescription": {
                "text": "A class that knows and does too much."
              },
              "defaultConfiguration": {
                "level": "warning"
              },
              "properties": {
                "category": "Design",
                "paradigms": [
                  "oop"
                ]
              }
            },
            {
              "id": "DSN005",
              "name": "Feature envy",
              "shortDescription": {
                "text": "A method using more data of one other type than of its own."
              },
              "fullDescription": {
                "text": "The method probably belongs to the other type."
              },
              "defaultConfiguration": {
                "level": "warning"
              },
              "properties": {
                "category": "Design",
                "paradigms": [
                  "oop"
                ]
              }
            },
            {
              "id": "DSN006",
              "name": "Blast radius",
              "shortDescription": {
                "text": "Number of types reachable through reversed dependencies (spec/metrics.md)."
              },
              "fullDescription": {
                "text": "Shows how far a change can propagate."
              },
              "defaultConfiguration": {
                "level": "warning"
              },
              "properties": {
                "category": "Design",
                "paradigms": []
              }
            },
            {
              "id": "FUN001",
              "name": "Impure function",
              "shortDescription": {
                "text": "A callable that returns a value and also writes state or performs I/O."
              },
              "fullDescription": {
                "text": "Cannot be reasoned about by substitution."
              },
              "defaultConfiguration": {
                "level": "warning"
              },
              "properties": {
                "category": "Paradigm",
                "paradigms": [
                  "functional"
                ]
              }
            },
            {
              "id": "FUN002",
              "name": "Side effect in lambda",
              "shortDescription": {
                "text": "A lambda passed to a higher-order function that changes outer variables."
              },
              "fullDescription": {
                "text": "The result depends on evaluation order."
              },
              "defaultConfiguration": {
                "level": "warning"
              },
              "properties": {
                "category": "Paradigm",
                "paradigms": [
                  "functional"
                ]
              }
            },
            {
              "id": "FUN003",
              "name": "Mutable state",
              "shortDescription": {
                "text": "Reassigned locals, mutable instance fields, settable properties."
              },
              "fullDescription": {
                "text": "Mutation makes data flow harder to follow."
              },
              "defaultConfiguration": {
                "level": "warning"
              },
              "properties": {
                "category": "Paradigm",
                "paradigms": [
                  "functional"
                ]
              }
            },
            {
              "id": "FUN004",
              "name": "Non-tail recursion",
              "shortDescription": {
                "text": "A self-call whose result is used further."
              },
              "fullDescription": {
                "text": "Cannot be turned into a loop by tail-call elimination."
              },
              "defaultConfiguration": {
                "level": "warning"
              },
              "properties": {
                "category": "Paradigm",
                "paradigms": [
                  "functional"
                ]
              }
            },
            {
              "id": "FUN005",
              "name": "Higher-order depth",
              "shortDescription": {
                "text": "Order of functions (data, functions, functions of functions) and lambda nesting."
              },
              "fullDescription": {
                "text": "High orders and nested lambdas are hard to follow."
              },
              "defaultConfiguration": {
                "level": "warning"
              },
              "properties": {
                "category": "Paradigm",
                "paradigms": [
                  "functional"
                ]
              }
            },
            {
              "id": "MNT001",
              "name": "Cyclomatic complexity",
              "shortDescription": {
                "text": "Decision points per callable (spec/metrics.md). Every value is a metric in facts; results are emitted above the limit."
              },
              "fullDescription": {
                "text": "More paths mean more tests and more room for mistakes."
              },
              "defaultConfiguration": {
                "level": "warning"
              },
              "properties": {
                "category": "Maintainability",
                "paradigms": []
              }
            },
            {
              "id": "MNT002",
              "name": "Maintainability index",
              "shortDescription": {
                "text": "MI from Halstead volume, cyclomatic complexity and lines (spec/metrics.md)."
              },
              "fullDescription": {
                "text": "A composite index; a hint, not a measurement of quality."
              },
              "defaultConfiguration": {
                "level": "warning"
              },
              "properties": {
                "category": "Maintainability",
                "paradigms": []
              }
            },
            {
              "id": "MNT003",
              "name": "Duplication",
              "shortDescription": {
                "text": "Type-1 and type-2 token clones (rolling hash over normalized tokens)."
              },
              "fullDescription": {
                "text": "A defect fixed in one copy stays in the others."
              },
              "defaultConfiguration": {
                "level": "warning"
              },
              "properties": {
                "category": "Maintainability",
                "paradigms": []
              }
            },
            {
              "id": "MNT004",
              "name": "Test coverage",
              "shortDescription": {
                "text": "Line coverage from a Cobertura or LCOV report, per file."
              },
              "fullDescription": {
                "text": "Shows which files tests do not reach."
              },
              "defaultConfiguration": {
                "level": "warning"
              },
              "properties": {
                "category": "Maintainability",
                "paradigms": []
              }
            },
            {
              "id": "OOP001",
              "name": "Encapsulation",
              "shortDescription": {
                "text": "Public mutable fields."
              },
              "fullDescription": {
                "text": "Hands a type's invariants to every caller."
              },
              "defaultConfiguration": {
                "level": "warning"
              },
              "properties": {
                "category": "Paradigm",
                "paradigms": [
                  "oop"
                ]
              }
            },
            {
              "id": "OOP002",
              "name": "Inheritance depth",
              "shortDescription": {
                "text": "Depth of inheritance tree (DIT)."
              },
              "fullDescription": {
                "text": "Deep hierarchies are hard to understand and change."
              },
              "defaultConfiguration": {
                "level": "warning"
              },
              "properties": {
                "category": "Paradigm",
                "paradigms": [
                  "oop"
                ]
              }
            },
            {
              "id": "OOP003",
              "name": "Polymorphism",
              "shortDescription": {
                "text": "Several runtime type tests on project types in one callable."
              },
              "fullDescription": {
                "text": "Usually reimplements virtual dispatch."
              },
              "defaultConfiguration": {
                "level": "warning"
              },
              "properties": {
                "category": "Paradigm",
                "paradigms": [
                  "oop"
                ]
              }
            },
            {
              "id": "OOP004",
              "name": "Cohesion",
              "shortDescription": {
                "text": "LCOM4, groups of methods that share no state."
              },
              "fullDescription": {
                "text": "More than one group suggests a class that could be split."
              },
              "defaultConfiguration": {
                "level": "warning"
              },
              "properties": {
                "category": "Paradigm",
                "paradigms": [
                  "oop"
                ]
              }
            },
            {
              "id": "OOP005",
              "name": "Coupling",
              "shortDescription": {
                "text": "Coupling between objects (CBO), excluding the standard library."
              },
              "fullDescription": {
                "text": "Many dependencies mean many reasons to change."
              },
              "defaultConfiguration": {
                "level": "warning"
              },
              "properties": {
                "category": "Paradigm",
                "paradigms": [
                  "oop"
                ]
              }
            },
            {
              "id": "OOP006",
              "name": "Refused bequest",
              "shortDescription": {
                "text": "A subclass that overrides nothing and touches no inherited member."
              },
              "fullDescription": {
                "text": "Gains nothing from its base class."
              },
              "defaultConfiguration": {
                "level": "warning"
              },
              "properties": {
                "category": "Paradigm",
                "paradigms": [
                  "oop"
                ]
              }
            },
            {
              "id": "PAT001",
              "name": "Singleton",
              "shortDescription": {
                "text": "A class with only private constructors that exposes a static instance of itself."
              },
              "fullDescription": {
                "text": "Informational: recognizes the pattern; hidden global state is a cost."
              },
              "defaultConfiguration": {
                "level": "note"
              },
              "properties": {
                "category": "Patterns",
                "paradigms": [
                  "oop"
                ]
              }
            },
            {
              "id": "PAT002",
              "name": "Factory",
              "shortDescription": {
                "text": "A method that returns an abstraction and creates several of its concrete subtypes."
              },
              "fullDescription": {
                "text": "Informational: recognizes the pattern."
              },
              "defaultConfiguration": {
                "level": "note"
              },
              "properties": {
                "category": "Patterns",
                "paradigms": [
                  "oop"
                ]
              }
            },
            {
              "id": "PAT003",
              "name": "Strategy",
              "shortDescription": {
                "text": "A context class that receives one of several interchangeable implementations and delegates to it."
              },
              "fullDescription": {
                "text": "Informational: recognizes the pattern."
              },
              "defaultConfiguration": {
                "level": "note"
              },
              "properties": {
                "category": "Patterns",
                "paradigms": [
                  "oop"
                ]
              }
            },
            {
              "id": "PAT004",
              "name": "Observer",
              "shortDescription": {
                "text": "A type with events it raises, or a list of observers it notifies in a loop, with subscribe methods."
              },
              "fullDescription": {
                "text": "Informational: recognizes the pattern."
              },
              "defaultConfiguration": {
                "level": "note"
              },
              "properties": {
                "category": "Patterns",
                "paradigms": [
                  "oop"
                ]
              }
            },
            {
              "id": "PAT005",
              "name": "Decorator",
              "shortDescription": {
                "text": "A class that implements an abstraction, wraps an instance of the same abstraction and forwards to it."
              },
              "fullDescription": {
                "text": "Informational: recognizes the pattern."
              },
              "defaultConfiguration": {
                "level": "note"
              },
              "properties": {
                "category": "Patterns",
                "paradigms": [
                  "oop"
                ]
              }
            },
            {
              "id": "PAT006",
              "name": "Repository",
              "shortDescription": {
                "text": "A type named *Repository, or a collection-like API of get, add and remove over one entity."
              },
              "fullDescription": {
                "text": "Informational: recognizes the pattern."
              },
              "defaultConfiguration": {
                "level": "note"
              },
              "properties": {
                "category": "Patterns",
                "paradigms": [
                  "oop"
                ]
              }
            },
            {
              "id": "PAT007",
              "name": "Builder",
              "shortDescription": {
                "text": "Fluent methods that return the type itself plus a terminal Build-like method."
              },
              "fullDescription": {
                "text": "Informational: recognizes the pattern."
              },
              "defaultConfiguration": {
                "level": "note"
              },
              "properties": {
                "category": "Patterns",
                "paradigms": [
                  "oop"
                ]
              }
            },
            {
              "id": "PAT101",
              "name": "Service Locator",
              "shortDescription": {
                "text": "Resolving dependencies from a container inside business code."
              },
              "fullDescription": {
                "text": "Hides dependencies from the constructor."
              },
              "defaultConfiguration": {
                "level": "warning"
              },
              "properties": {
                "category": "Patterns",
                "paradigms": [
                  "oop"
                ]
              }
            },
            {
              "id": "PAT102",
              "name": "Anemic Domain Model",
              "shortDescription": {
                "text": "A domain-named class with settable data and no behavior, while logic lives in services."
              },
              "fullDescription": {
                "text": "Behavior is separated from the data it belongs to."
              },
              "defaultConfiguration": {
                "level": "warning"
              },
              "properties": {
                "category": "Patterns",
                "paradigms": [
                  "oop"
                ]
              }
            },
            {
              "id": "PAT103",
              "name": "Middle Man",
              "shortDescription": {
                "text": "A class that does almost nothing but forward to one collaborator, without a shared abstraction."
              },
              "fullDescription": {
                "text": "An extra hop with no value of its own."
              },
              "defaultConfiguration": {
                "level": "warning"
              },
              "properties": {
                "category": "Patterns",
                "paradigms": [
                  "oop"
                ]
              }
            },
            {
              "id": "PRN001",
              "name": "Single Responsibility",
              "shortDescription": {
                "text": "Counts constructor dependencies of a class and the project modules it reaches into."
              },
              "fullDescription": {
                "text": "A class with many collaborators likely has several reasons to change."
              },
              "defaultConfiguration": {
                "level": "warning"
              },
              "properties": {
                "category": "Principles",
                "paradigms": [
                  "oop"
                ]
              }
            },
            {
              "id": "PRN002",
              "name": "Open/Closed",
              "shortDescription": {
                "text": "Finds the same enum or tag switched on in several places."
              },
              "fullDescription": {
                "text": "Adding a value then means editing every switch."
              },
              "defaultConfiguration": {
                "level": "warning"
              },
              "properties": {
                "category": "Principles",
                "paradigms": [
                  "oop"
                ]
              }
            },
            {
              "id": "PRN003",
              "name": "Liskov Substitution",
              "shortDescription": {
                "text": "An override or implementation whose body only throws not-supported or not-implemented."
              },
              "fullDescription": {
                "text": "Such a member cannot stand in for its base type."
              },
              "defaultConfiguration": {
                "level": "warning"
              },
              "properties": {
                "category": "Principles",
                "paradigms": [
                  "oop"
                ]
              }
            },
            {
              "id": "PRN004",
              "name": "Interface Segregation",
              "shortDescription": {
                "text": "Interfaces with many members, or whose implementers stub some of them."
              },
              "fullDescription": {
                "text": "Clients are forced to depend on members they do not use."
              },
              "defaultConfiguration": {
                "level": "warning"
              },
              "properties": {
                "category": "Principles",
                "paradigms": [
                  "oop"
                ]
              }
            },
            {
              "id": "PRN005",
              "name": "Dependency Inversion",
              "shortDescription": {
                "text": "Creating a project class that implements a project abstraction, outside composition roots and test classes (a class with test-framework attributes such as Fact, Theory, Test, TestMethod, TestCase)."
              },
              "fullDescription": {
                "text": "The caller is bound to the concrete type."
              },
              "defaultConfiguration": {
                "level": "warning"
              },
              "properties": {
                "category": "Principles",
                "paradigms": [
                  "oop"
                ]
              }
            },
            {
              "id": "PRN006",
              "name": "Do not repeat yourself",
              "shortDescription": {
                "text": "Callables whose structure is identical up to local names and literals."
              },
              "fullDescription": {
                "text": "One piece of knowledge is encoded twice."
              },
              "defaultConfiguration": {
                "level": "warning"
              },
              "properties": {
                "category": "Principles",
                "paradigms": []
              }
            },
            {
              "id": "PRN007",
              "name": "Keep it simple",
              "shortDescription": {
                "text": "Long boolean conditions and nested ternaries."
              },
              "fullDescription": {
                "text": "Too many decisions are packed into one expression."
              },
              "defaultConfiguration": {
                "level": "warning"
              },
              "properties": {
                "category": "Principles",
                "paradigms": []
              }
            },
            {
              "id": "PRN008",
              "name": "You are not going to need it",
              "shortDescription": {
                "text": "Non-public abstractions with too few implementers, and unused private parameters."
              },
              "fullDescription": {
                "text": "Generality that nothing uses."
              },
              "defaultConfiguration": {
                "level": "warning"
              },
              "properties": {
                "category": "Principles",
                "paradigms": []
              }
            },
            {
              "id": "PRN009",
              "name": "Law of Demeter",
              "shortDescription": {
                "text": "Call chains that walk through several distinct project types."
              },
              "fullDescription": {
