{
  "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
  "version": "2.1.0",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "nomos-csharp",
          "version": "0.1.0",
          "semanticVersion": "0.1.0",
          "rules": [
            {
              "id": "ALG001",
              "name": "Time complexity estimate",
              "shortDescription": {
                "text": "Estimates growth from loop nesting, known linear calls, recursion shape and project callees."
              },
              "fullDescription": {
                "text": "Always an estimate; input sizes are unknown."
              },
              "defaultConfiguration": {
                "level": "warning"
              },
              "messageStrings": {
                "likely": {
                  "text": "{0} is likely {1}"
                },
                "loops": {
                  "text": "Estimated from nested loops over inputs of unknown size. Small inputs may make this irrelevant."
                },
                "recursion": {
                  "text": "Estimated from recursion, a while loop or a callee; loop bounds and call counts are not known exactly."
                },
                "recursionConditionLoop": {
                  "text": "Estimated from recursion, a condition-only loop or a callee; loop bounds and call counts are not known exactly."
                }
              },
              "properties": {
                "category": "Algorithms",
                "paradigms": []
              }
            },
            {
              "id": "ALG002",
              "name": "Quadratic pattern",
              "shortDescription": {
                "text": "List searches, front insertions and string concatenation inside loops."
              },
              "fullDescription": {
                "text": "Typical sources of accidental quadratic time."
              },
              "defaultConfiguration": {
                "level": "warning"
              },
              "messageStrings": {
                "concat": {
                  "text": "Likely quadratic: String concatenation inside a loop"
                },
                "concatBuilder": {
                  "text": "Each step copies the whole string so far. strings.Builder grows in amortized constant time."
                },
                "concatStringBuilder": {
                  "text": "Each step copies the whole string so far. StringBuilder grows in amortized constant time."
                },
                "frontCall": {
                  "text": "Likely quadratic: {0}(0) inside a loop"
                },
                "frontCallQueue": {
                  "text": "Every element shifts on each call. A Queue, a Stack or iterating from the end avoids this."
                },
                "frontInsert": {
                  "text": "Likely quadratic: front insertion inside a loop"
                },
                "frontInsertAppend": {
                  "text": "Every element shifts on each call. Appending and reversing once avoids this."
                },
                "search": {
                  "text": "Likely quadratic: {0} on a sequence inside a loop"
                },
                "searchHashSet": {
                  "text": "Each iteration scans the sequence. A HashSet or Dictionary built once makes the lookup constant-time."
                },
                "searchMap": {
                  "text": "Each iteration scans the sequence. A map built once makes the lookup constant-time."
                },
                "searchOn": {
                  "text": "Likely quadratic: {0} on {1} inside a loop"
                },
                "slicesSearch": {
                  "text": "Likely quadratic: slices.{0} inside a loop"
                }
              },
              "properties": {
                "category": "Algorithms",
                "paradigms": []
              }
            },
            {
              "id": "ALG003",
              "name": "Allocation in hot loop",
              "shortDescription": {
                "text": "Materializing calls in loops; object creation or closures in nested loops."
              },
              "fullDescription": {
                "text": "Allocation pressure in frequently executed code."
              },
              "defaultConfiguration": {
                "level": "warning"
              },
              "messageStrings": {
                "allocation": {
                  "text": "Allocation in a nested loop"
                },
                "allocationOf": {
                  "text": "Allocation of {0} in a nested loop"
                },
                "hot": {
                  "text": "Runs once per inner iteration. Whether it matters depends on how hot the loop really is, which static analysis cannot tell."
                },
                "lambda": {
                  "text": "Lambda in a nested loop"
                },
                "lambdaClosure": {
                  "text": "A capturing lambda allocates a closure per iteration; a non-capturing one is cached."
                },
                "literal": {
                  "text": "Function literal in a nested loop"
                },
                "literalClosure": {
                  "text": "A capturing literal allocates a closure per iteration."
                },
                "materialize": {
                  "text": "{0} allocates on each loop iteration"
                },
                "materializeBuffer": {
                  "text": "A new collection is built per iteration; moving it out of the loop or reusing a buffer reduces GC pressure."
                }
              },
              "properties": {
                "category": "Algorithms",
                "paradigms": []
              }
            },
            {
              "id": "ALG004",
              "name": "Space complexity estimate",
              "shortDescription": {
                "text": "Collections growing in loops, arrays of non-constant size, recursion depth."
              },
              "fullDescription": {
                "text": "Always an estimate; input sizes are unknown."
              },
              "defaultConfiguration": {
                "level": "warning"
              },
              "messageStrings": {
                "collections": {
                  "text": "Estimated from collection growth under nested loops or multi-dimensional allocation sizes."
                },
                "likely": {
                  "text": "{0} likely uses {1} extra memory"
                },
                "slices": {
                  "text": "Estimated from slice growth under nested loops or sized allocations."
                }
              },
              "properties": {
                "category": "Algorithms",
                "paradigms": []
              }
            },
            {
              "id": "CC001",
              "name": "Long method",
              "shortDescription": {
                "text": "Source lines of a callable."
              },
              "fullDescription": {
                "text": "Long callables are harder to read and test."
              },
              "defaultConfiguration": {
                "level": "warning"
              },
              "messageStrings": {
                "limit": {
                  "text": "The line count is exact; the limit of {0} is a readability convention."
                },
                "lines": {
                  "text": "{0} spans {1} lines"
                }
              },
              "properties": {
                "category": "CleanCode",
                "paradigms": [
                  "functional",
                  "oop",
                  "structural"
                ]
              }
            },
            {
              "id": "CC002",
              "name": "Large class",
              "shortDescription": {
                "text": "Lines and members of a type, over all of its parts."
              },
              "fullDescription": {
                "text": "A large type tends to collect several responsibilities."
              },
              "defaultConfiguration": {
                "level": "warning"
              },
              "messageStrings": {
                "limits": {
                  "text": "The counts are exact; the limits ({0} lines, {1} members) are conventions."
                },
                "size": {
                  "text": "{0} has {1} lines and {2} members"
                }
              },
              "properties": {
                "category": "CleanCode",
                "paradigms": [
                  "oop"
                ]
              }
            },
            {
              "id": "CC003",
              "name": "Too many parameters",
              "shortDescription": {
                "text": "Parameter count of a callable; constructors have a separate limit because of dependency injection."
              },
              "fullDescription": {
                "text": "Long parameter lists are hard to call correctly."
              },
              "defaultConfiguration": {
                "level": "warning"
              },
              "messageStrings": {
                "count": {
                  "text": "{0} takes {1} parameters"
                },
                "limitObject": {
                  "text": "The limit is {0}. Long lists are easy to misorder; a parameter object groups what belongs together."
                },
                "limitStruct": {
                  "text": "The limit is {0}. Long lists are easy to misorder; a parameter struct groups what belongs together."
                }
              },
              "properties": {
                "category": "CleanCode",
                "paradigms": [
                  "functional",
                  "oop",
                  "structural"
                ]
              }
            },
            {
              "id": "CC004",
              "name": "Deep nesting",
              "shortDescription": {
                "text": "Nesting depth of branches, loops and guarded blocks; else-if chains stay flat."
              },
              "fullDescription": {
                "text": "Each level adds a condition the reader must hold in mind."
              },
              "defaultConfiguration": {
                "level": "warning"
              },
              "messageStrings": {
                "depth": {
                  "text": "{0} nests {1} levels deep"
                },
                "limitFunctions": {
                  "text": "The limit is {0}. Guard clauses or extracted functions flatten the flow."
                },
                "limitMethods": {
                  "text": "The limit is {0}. Guard clauses or extracted methods flatten the flow."
                }
              },
              "properties": {
                "category": "CleanCode",
                "paradigms": [
                  "functional",
                  "oop",
                  "structural"
                ]
              }
            },
            {
              "id": "CC006",
              "name": "Placeholders",
              "shortDescription": {
                "text": "TODO, FIXME, HACK and XXX comments, and bodies that only throw not-implemented."
              },
              "fullDescription": {
                "text": "Marks unfinished work."
              },
              "defaultConfiguration": {
                "level": "warning"
              },
              "messageStrings": {
                "comment": {
                  "text": "{0} comment left in code"
                },
                "commentTracker": {
                  "text": "A placeholder records unfinished work that belongs in the issue tracker or in a fix."
                },
                "notImplemented": {
                  "text": "{0} is not implemented"
                },
                "notImplementedThrows": {
                  "text": "The body only throws NotImplementedException."
                }
              },
              "properties": {
                "category": "CleanCode",
                "paradigms": [
                  "functional",
                  "oop",
                  "structural"
                ]
              }
            },
            {
              "id": "CC007",
              "name": "Dead code",
              "shortDescription": {
                "text": "Unreachable statements, unused locals, private members nothing refers to."
              },
              "fullDescription": {
                "text": "Code that never runs still has to be read."
              },
              "defaultConfiguration": {
                "level": "warning"
              },
              "messageStrings": {
                "field": {
                  "text": "Private field {0} is never used"
                },
                "local": {
                  "text": "Local {0} is never read"
                },
                "localInitializer": {
                  "text": "No expression in the callable reads this variable; its initializer may still have side effects."
                },
                "method": {
                  "text": "Private method {0} is never called"
                },
                "reflection": {
                  "text": "Nothing in the declaring type refers to it; only reflection could reach it."
                },
                "unreachable": {
                  "text": "Unreachable code in {0}"
                },
                "unreachableLeaves": {
                  "text": "The preceding statement always leaves this block."
                }
              },
              "properties": {
                "category": "CleanCode",
                "paradigms": [
                  "functional",
                  "oop",
                  "structural"
                ]
              }
            },
            {
              "id": "CC008",
              "name": "Commented-out code",
              "shortDescription": {
                "text": "Line comments that end like statements."
              },
              "fullDescription": {
                "text": "Version control keeps history; disabled code is noise."
              },
              "defaultConfiguration": {
                "level": "warning"
              },
              "messageStrings": {
                "code": {
                  "text": "Comment looks like disabled code"
                },
                "shape": {
                  "text": "The comment has the shape of a statement; a textual heuristic cannot tell it from prose with certainty."
                }
              },
              "properties": {
                "category": "CleanCode",
                "paradigms": [
                  "functional",
                  "oop",
                  "structural"
                ]
              }
            },
            {
              "id": "CC009",
              "name": "Empty catch",
              "shortDescription": {
                "text": "A catch block with no statements and no comment."
              },
              "fullDescription": {
                "text": "The failure is silently discarded."
              },
              "defaultConfiguration": {
                "level": "warning"
              },
              "messageStrings": {
                "disappears": {
                  "text": "The exception disappears without handling, logging or a comment saying why that is safe."
                },
                "empty": {
                  "text": "Empty catch in {0}"
                }
              },
              "properties": {
                "category": "CleanCode",
                "paradigms": [
                  "functional",
                  "oop",
                  "structural"
                ]
              }
            },
            {
              "id": "CS.NAM001",
              "name": "Naming conventions",
              "shortDescription": {
                "text": "Types, methods and properties in PascalCase, interfaces start with I, parameters in camelCase; one-letter parameters of public methods."
              },
              "fullDescription": {
                "text": "Departures from .NET conventions slow reading. Formerly CC005."
              },
              "defaultConfiguration": {
                "level": "note"
              },
              "messageStrings": {
                "interface": {
                  "text": "The interface name {0} is not IPascalCase"
                },
                "interfaceConvention": {
                  "text": "C# convention for an interface is IPascalCase."
                },
                "method": {
                  "text": "The method name {0} is not PascalCase"
                },
                "methodConvention": {
                  "text": "C# convention for a method is PascalCase."
                },
                "parameter": {
                  "text": "The parameter name {0} is not camelCase"
                },
                "parameterConvention": {
                  "text": "C# convention for a parameter is camelCase."
                },
                "property": {
                  "text": "The property name {0} is not PascalCase"
                },
                "propertyConvention": {
                  "text": "C# convention for a property is PascalCase."
                },
                "shortParameter": {
                  "text": "Parameter {0} of {1} says little"
                },
                "shortParameterMeaning": {
                  "text": "One-letter names in a public signature leave the meaning to the reader."
                },
                "type": {
                  "text": "The type name {0} is not PascalCase"
                },
                "typeConvention": {
                  "text": "C# convention for a type is PascalCase."
                }
              },
              "properties": {
                "category": "CleanCode",
                "paradigms": [
                  "functional",
                  "oop",
                  "structural"
                ]
              }
            },
            {
              "id": "DSN001",
              "name": "Main sequence distance",
              "shortDescription": {
                "text": "Per module Ca, Ce, instability I, abstractness A and distance D (spec/metrics.md)."
              },
              "fullDescription": {
                "text": "D near 1 means a module is rigid or useless."
              },
              "defaultConfiguration": {
                "level": "warning"
              },
              "messageStrings": {
                "distance": {
                  "text": "Module {0} is far from the main sequence (D = {1})"
                },
                "pain": {
                  "text": "A = {0}, I = {1}, so it sits near the zone of pain: concrete and heavily depended upon."
                },
                "uselessness": {
                  "text": "A = {0}, I = {1}, so it sits near the zone of uselessness: abstract and unused."
                }
              },
              "properties": {
                "category": "Design",
                "paradigms": []
              }
            },
            {
              "id": "DSN002",
              "name": "Dependency cycles",
              "shortDescription": {
                "text": "Strongly connected components (Tarjan) in the module graph and the type graph."
              },
              "fullDescription": {
                "text": "Members of a cycle cannot be understood or changed separately."
              },
              "defaultConfiguration": {
                "level": "warning"
              },
              "messageStrings": {
                "modules": {
                  "text": "Module cycle: {0}"
                },
                "modulesAlone": {
                  "text": "These modules depend on each other, directly or transitively, so none can be built, tested or released alone."
                },
                "types": {
                  "text": "Type cycle of {0}: {1}"
                },
                "typesRipple": {
                  "text": "These types reference each other, so a change to one can ripple through all of them."
                },
                "unitsRipple": {
                  "text": "These units reference each other, so a change to one can ripple through all of them."
                }
              },
              "properties": {
                "category": "Design",
                "paradigms": []
              }
            },
            {
              "id": "DSN003",
              "name": "Layer violations",
              "shortDescription": {
                "text": "Dependencies on layers that the configuration does not allow."
              },
              "fullDescription": {
                "text": "Layering was declared by the team and is being bypassed."
              },
              "defaultConfiguration": {
                "level": "warning"
              },
              "messageStrings": {
                "allowed": {
                  "text": "{0} ({1}) uses {2} ({3}); allowed: {4}."
                },
                "allowedNone": {
                  "text": "{0} ({1}) uses {2} ({3}); allowed: none."
                },
                "violation": {
                  "text": "{0} must not depend on {1}"
                }
              },
              "properties": {
                "category": "Design",
                "paradigms": []
              }
            },
            {
              "id": "DSN004",
              "name": "God class",
              "shortDescription": {
                "text": "Lanza and Marinescu detection strategy, high WMC, high ATFD, low TCC."
              },
              "fullDescription": {
                "text": "A class that knows and does too much."
              },
              "defaultConfiguration": {
                "level": "warning"
              },
              "messageStrings": {
                "god": {
                  "text": "{0} looks like a god class"
                },
                "metrics": {
                  "text": "WMC = {0} (>= {1}), ATFD = {2} (>= {3}), TCC = {4} (< {5}): it does much, uses others' data, and its methods share little."
                }
              },
              "properties": {
                "category": "Design",
                "paradigms": [
                  "oop"
                ]
              }
            },
            {
              "id": "DSN005",
              "name": "Feature envy",
              "shortDescription": {
                "text": "A method using more data of one other type than of its own."
              },
              "fullDescription": {
                "text": "The method probably belongs to the other type."
              },
              "defaultConfiguration": {
                "level": "warning"
              },
              "messageStrings": {
                "envy": {
                  "text": "{0} is more interested in {1} than in {2}"
                },
                "members": {
                  "text": "It uses {0} members of {1} ({2}) and {3} of its own."
                }
              },
              "properties": {
                "category": "Design",
                "paradigms": [
                  "oop"
                ]
              }
            },
            {
              "id": "DSN006",
              "name": "Blast radius",
              "shortDescription": {
                "text": "Number of types reachable through reversed dependencies (spec/metrics.md)."
              },
              "fullDescription": {
                "text": "Shows how far a change can propagate."
              },
              "defaultConfiguration": {
                "level": "warning"
              },
              "messageStrings": {
                "stable": {
                  "text": "Stable abstractions at such points limit the spread. Static dependencies overstate real impact when a change keeps the contract."
                },
                "types": {
                  "text": "Changing {0} can reach {1} types ({2})"
                },
                "typesHops": {
                  "text": "{0} direct dependents, up to {1} hops away. Stable abstractions at such points limit the spread. Static dependencies overstate real impact when a change keeps the contract."
                },
                "units": {
                  "text": "Changing {0} can reach {1} units"
                }
              },
              "properties": {
                "category": "Design",
                "paradigms": []
              }
            },
            {
              "id": "FUN001",
              "name": "Impure function",
              "shortDescription": {
                "text": "A callable that returns a value and also writes state or performs I/O."
              },
              "fullDescription": {
                "text": "Cannot be reasoned about by substitution."
              },
              "defaultConfiguration": {
                "level": "warning"
              },
              "messageStrings": {
                "impure": {
                  "text": "{0} returns a value and has side effects"
                },
                "observed": {
                  "text": "Observed: {0}. Effects hidden behind calls to other methods are not visible here."
                }
              },
              "properties": {
                "category": "Paradigm",
                "paradigms": [
                  "functional"
                ]
              }
            },
            {
              "id": "FUN002",
              "name": "Side effect in lambda",
              "shortDescription": {
                "text": "A lambda passed to a higher-order function that changes outer variables."
              },
              "fullDescription": {
                "text": "The result depends on evaluation order."
              },
              "defaultConfiguration": {
                "level": "warning"
              },
              "messageStrings": {
                "lambda": {
                  "text": "Lambda changes state outside itself"
                },
                "writes": {
                  "text": "It writes {0}. With lazy or parallel evaluation, the order of these writes is not guaranteed."
                }
              },
              "properties": {
                "category": "Paradigm",
                "paradigms": [
                  "functional"
                ]
              }
            },
            {
              "id": "FUN003",
              "name": "Mutable state",
              "shortDescription": {
                "text": "Reassigned locals, mutable instance fields, settable properties."
              },
              "fullDescription": {
                "text": "Mutation makes data flow harder to follow."
              },
              "defaultConfiguration": {
                "level": "warning"
              },
              "messageStrings": {
                "members": {
                  "text": "{0} has mutable members: {1}"
                },
                "newName": {
                  "text": "In functional style a new value gets a new name. Reassignment makes the meaning of a variable depend on the position in the code."
                },
                "reassigns": {
                  "text": "{0} reassigns {1}"
                },
                "time": {
                  "text": "Instances can change after construction, so a value's meaning depends on time."
                }
              },
              "properties": {
                "category": "Paradigm",
                "paradigms": [
                  "functional"
                ]
              }
            },
            {
              "id": "FUN004",
              "name": "Non-tail recursion",
              "shortDescription": {
                "text": "A self-call whose result is used further."
              },
              "fullDescription": {
                "text": "Cannot be turned into a loop by tail-call elimination."
              },
              "defaultConfiguration": {
                "level": "warning"
              },
              "messageStrings": {
                "recursion": {
                  "text": "{0} recurses outside tail position"
                },
                "stack": {
                  "text": "Work remains after the self-call returns, so each level keeps a stack frame; deep input can overflow the stack."
                }
              },
              "properties": {
                "category": "Paradigm",
                "paradigms": [
                  "functional"
                ]
              }
            },
            {
              "id": "FUN005",
              "name": "Higher-order depth",
              "shortDescription": {
                "text": "Order of functions (data, functions, functions of functions) and lambda nesting."
              },
              "fullDescription": {
                "text": "High orders and nested lambdas are hard to follow."
              },
              "defaultConfiguration": {
                "level": "warning"
              },
              "messageStrings": {
                "lambdas": {
                  "text": "{0} nests lambdas {1} levels deep"
                },
                "lambdasNamed": {
                  "text": "Beyond {0} levels, captured variables are hard to trace; named functions help."
                },
                "literals": {
                  "text": "{0} nests function literals {1} deep"
                },
                "literalsTrace": {
                  "text": "Beyond {0} levels, captured variables are hard to trace."
                },
                "order": {
                  "text": "{0} is a function of order {1}"
                },
                "orderLimit": {
                  "text": "The signature nests function types beyond order {0}."
                },
                "orderOf": {
                  "text": "{0} has order {1}"
                }
              },
              "properties": {
                "category": "Paradigm",
                "paradigms": [
                  "functional"
                ]
              }
            },
            {
              "id": "MNT001",
              "name": "Cyclomatic complexity",
              "shortDescription": {
                "text": "Decision points per callable (spec/metrics.md). Every value is a metric in facts; results are emitted above the limit."
              },
              "fullDescription": {
                "text": "More paths mean more tests and more room for mistakes."
              },
              "defaultConfiguration": {
                "level": "warning"
              },
              "messageStrings": {
                "complexity": {
                  "text": "{0} has cyclomatic complexity {1}"
                },
                "paths": {
                  "text": "The count is exact; above {0}, the number of paths to test and to understand grows quickly."
                }
              },
              "properties": {
                "category": "Maintainability",
                "paradigms": []
              }
            },
            {
              "id": "MNT002",
              "name": "Maintainability index",
              "shortDescription": {
                "text": "MI from Halstead volume, cyclomatic complexity and lines (spec/metrics.md)."
              },
              "fullDescription": {
                "text": "A composite index; a hint, not a measurement of quality."
              },
              "defaultConfiguration": {
                "level": "warning"
              },
              "messageStrings": {
                "index": {
                  "text": "{0} has a maintainability index of {1}"
                },
                "ranking": {
                  "text": "Below {0}. The formula is an empirical blend of size and complexity, useful for ranking rather than as a measure of quality."
                }
              },
              "properties": {
                "category": "Maintainability",
                "paradigms": []
              }
            },
            {
              "id": "MNT003",
              "name": "Duplication",
              "shortDescription": {
                "text": "Type-1 and type-2 token clones (rolling hash over normalized tokens)."
              },
              "fullDescription": {
                "text": "A defect fixed in one copy stays in the others."
              },
              "defaultConfiguration": {
                "level": "warning"
              },
              "messageStrings": {
                "clone": {
                  "text": "{0} tokens duplicate {1}:{2}"
                },
                "identical": {
                  "text": "The token sequences are identical after replacing identifiers and literals with placeholders."
                }
              },
              "properties": {
                "category": "Maintainability",
                "paradigms": []
              }
            },
            {
              "id": "MNT004",
              "name": "Test coverage",
              "shortDescription": {
                "text": "Line coverage from a Cobertura or LCOV report, per file."
              },
              "fullDescription": {
                "text": "Shows which files tests do not reach."
              },
              "defaultConfiguration": {
                "level": "warning"
              },
              "messageStrings": {
                "coverage": {
                  "text": "{0} has {1}% line coverage"
                },
                "minimum": {
                  "text": "Measured from {0}; below the {1}% minimum. Coverage shows what ran, not what was verified."
                }
              },
              "properties": {
                "category": "Maintainability",
                "paradigms": []
              }
            },
            {
              "id": "OOP001",
              "name": "Encapsulation",
              "shortDescription": {
                "text": "Public mutable fields."
              },
              "fullDescription": {
                "text": "Hands a type's invariants to every caller."
              },
              "defaultConfiguration": {
                "level": "warning"
              },
              "messageStrings": {
                "field": {
                  "text": "Public mutable field {0}.{1}"
                },
                "invariants": {
                  "text": "Any caller can change this field, so the type cannot protect its invariants. A property or a method can."
                }
              },
              "properties": {
                "category": "Paradigm",
                "paradigms": [
                  "oop"
                ]
              }
            },
            {
              "id": "OOP002",
              "name": "Inheritance depth",
              "shortDescription": {
                "text": "Depth of inheritance tree (DIT)."
              },
              "fullDescription": {
                "text": "Deep hierarchies are hard to understand and change."
              },
              "defaultConfiguration": {
                "level": "warning"
              },
              "messageStrings": {
                "composition": {
                  "text": "The depth counts base classes in the project; a base outside it is one step. Beyond {0} levels, behavior is spread over many classes. Composition often reads better."
                },
                "depth": {
                  "text": "{0} sits {1} levels deep"
                },
                "embeds": {
                  "text": "{0} embeds {1} levels deep"
                },
                "promoted": {
                  "text": "The limit is {0}; promoted members come from far away."
                }
              },
              "properties": {
                "category": "Paradigm",
                "paradigms": [
                  "oop"
                ]
              }
            },
            {
              "id": "OOP003",
              "name": "Polymorphism",
              "shortDescription": {
                "text": "Several runtime type tests on project types in one callable."
              },
              "fullDescription": {
                "text": "Usually reimplements virtual dispatch."
              },
              "defaultConfiguration": {
                "level": "warning"
              },
              "messageStrings": {
                "branches": {
                  "text": "{0} branches on {1} runtime types"
                },
                "interface": {
                  "text": "A type switch over project types is what an interface method can replace."
                },
                "tests": {
                  "text": "{0} tests {1} project types at run time"
                },
                "virtual": {
                  "text": "It tests for {0}. A virtual member on their common base would dispatch without the checks."
                }
              },
              "properties": {
                "category": "Paradigm",
                "paradigms": [
                  "oop"
                ]
              }
            },
            {
              "id": "OOP004",
              "name": "Cohesion",
              "shortDescription": {
                "text": "LCOM4, groups of methods that share no state."
              },
              "fullDescription": {
                "text": "More than one group suggests a class that could be split."
              },
              "defaultConfiguration": {
                "level": "warning"
              },
              "messageStrings": {
                "groups": {
                  "text": "{0} has {1} unrelated method groups"
                },
                "lcom": {
                  "text": "LCOM4 finds method groups that share no field and do not call each other; each may be a separate class."
                },
                "responsibilities": {
                  "text": "Groups of methods that share no state may be separate responsibilities."
                },
                "splits": {
                  "text": "{0} splits into {1} unrelated method groups"
                }
              },
              "properties": {
                "category": "Paradigm",
                "paradigms": [
                  "oop"
                ]
              }
            },
            {
              "id": "OOP005",
              "name": "Coupling",
              "shortDescription": {
                "text": "Coupling between objects (CBO), excluding the standard library."
              },
              "fullDescription": {
                "text": "Many dependencies mean many reasons to change."
              },
              "defaultConfiguration": {
                "level": "warning"
              },
              "messageStrings": {
                "collaborators": {
                  "text": "Beyond {0} collaborators, changes elsewhere are likely to reach this class."
                },
                "coupled": {
                  "text": "{0} is coupled to {1} types"
                },
                "dependsOn": {
                  "text": "{0} depends on {1} types"
                },
                "reason": {
                  "text": "The limit is {0}; each dependency is a reason to change."
                }
              },
              "properties": {
                "category": "Paradigm",
                "paradigms": [
                  "oop"
                ]
              }
            },
            {
              "id": "OOP006",
              "name": "Refused bequest",
              "shortDescription": {
                "text": "A subclass that overrides nothing and touches no inherited member."
              },
              "fullDescription": {
                "text": "Gains nothing from its base class."
              },
              "defaultConfiguration": {
                "level": "warning"
              },
              "messageStrings": {
                "offers": {
                  "text": "{0} offers {1} members; none are overridden or used here. Outside callers may still rely on the inherited API, which this check cannot rule out."
                },
                "refused": {
                  "text": "{0} inherits {1} but uses none of it"
                }
              },
              "properties": {
                "category": "Paradigm",
                "paradigms": [
                  "oop"
                ]
              }
            },
            {
              "id": "PAT001",
              "name": "Singleton",
              "shortDescription": {
                "text": "A class with only private constructors that exposes a static instance of itself."
              },
              "fullDescription": {
                "text": "Informational: recognizes the pattern; hidden global state is a cost."
              },
              "defaultConfiguration": {
                "level": "note"
              },
              "messageStrings": {
                "global": {
                  "text": "Private constructors plus a static member of its own type. Singletons are global state: they hide dependencies and hinder testing."
                },
                "singleton": {
                  "text": "{0} is a Singleton"
                }
              },
              "properties": {
                "category": "Patterns",
                "paradigms": [
                  "oop"
                ]
              }
            },
            {
              "id": "PAT002",
              "name": "Factory",
              "shortDescription": {
                "text": "A method that returns an abstraction and creates several of its concrete subtypes."
              },
              "fullDescription": {
                "text": "Informational: recognizes the pattern."
              },
              "defaultConfiguration": {
                "level": "note"
              },
              "messageStrings": {
                "creates": {
                  "text": "It returns the abstraction and creates {0}."
                },
                "factory": {
                  "text": "{0} is a Factory of {1}"
                },
                "named": {
                  "text": "The type name and the creation of {0} behind the abstraction suggest it."
                }
              },
              "properties": {
                "category": "Patterns",
                "paradigms": [
                  "oop"
                ]
              }
            },
            {
              "id": "PAT003",
              "name": "Strategy",
              "shortDescription": {
                "text": "A context class that receives one of several interchangeable implementations and delegates to it."
              },
              "fullDescription": {
                "text": "Informational: recognizes the pattern."
              },
              "defaultConfiguration": {
                "level": "note"
              },
              "messageStrings": {
                "injected": {
                  "text": "It holds an injected {0}, with {1} implementations: {2}."
                },
                "strategy": {
                  "text": "{0} uses {1} as a Strategy"
                }
              },
              "properties": {
                "category": "Patterns",
                "paradigms": [
                  "oop"
                ]
              }
            },
            {
              "id": "PAT004",
              "name": "Observer",
              "shortDescription": {
                "text": "A type with events it raises, or a list of observers it notifies in a loop, with subscribe methods."
              },
              "fullDescription": {
                "text": "Informational: recognizes the pattern."
              },
              "defaultConfiguration": {
                "level": "note"
              },
              "messageStrings": {
                "events": {
                  "text": "It publishes events: {0}."
                },
                "subject": {
                  "text": "{0} is an Observer subject"
                },
                "subscribe": {
                  "text": "It has a subscribe method and notifies registered observers in a loop."
                }
              },
              "properties": {
                "category": "Patterns",
                "paradigms": [
                  "oop"
                ]
              }
            },
            {
              "id": "PAT005",
              "name": "Decorator",
              "shortDescription": {
                "text": "A class that implements an abstraction, wraps an instance of the same abstraction and forwards to it."
              },
              "fullDescription": {
                "text": "Informational: recognizes the pattern."
              },
              "defaultConfiguration": {
                "level": "note"
              },
              "messageStrings": {
                "decorator": {
                  "text": "{0} is a Decorator of {1}"
                },
                "forwards": {
                  "text": "It implements the abstraction, wraps an instance of it, and forwards calls."
                }
              },
              "properties": {
                "category": "Patterns",
                "paradigms": [
                  "oop"
                ]
              }
            },
            {
              "id": "PAT006",
              "name": "Repository",
              "shortDescription": {
                "text": "A type named *Repository, or a collection-like API of get, add and remove over one entity."
              },
              "fullDescription": {
                "text": "Informational: recognizes the pattern."
              },
              "defaultConfiguration": {
                "level": "note"
              },
              "messageStrings": {
                "agree": {
                  "text": "The name and the collection-like read/write API agree."
                },
                "maybe": {
                  "text": "{0} may be a Repository"
                },
                "nameOnly": {
                  "text": "Only the name suggests it; the API is not collection-like."
                },
                "repository": {
                  "text": "{0} is a Repository"
                }
              },
              "properties": {
                "category": "Patterns",
                "paradigms": [
                  "oop"
                ]
              }
            },
            {
              "id": "PAT007",
              "name": "Builder",
              "shortDescription": {
                "text": "Fluent methods that return the type itself plus a terminal Build-like method."
              },
              "fullDescription": {
                "text": "Informational: recognizes the pattern."
              },
              "defaultConfiguration": {
                "level": "note"
              },
              "messageStrings": {
                "builder": {
                  "text": "{0} is a Builder"
                },
                "fluent": {
                  "text": "{0} fluent methods return this, and a terminal method builds the result."
                }
              },
              "properties": {
                "category": "Patterns",
                "paradigms": [
                  "oop"
                ]
              }
            },
            {
              "id": "PAT101",
              "name": "Service Locator",
              "shortDescription": {
                "text": "Resolving dependencies from a container inside business code."
              },
              "fullDescription": {
                "text": "Hides dependencies from the constructor."
              },
              "defaultConfiguration": {
                "level": "warning"
              },
              "messageStrings": {
                "invisible": {
                  "text": "The class's real dependencies are invisible in its constructor and fail only at run time."
                },
                "pulls": {
                  "text": "{0} pulls a dependency from {1}"
                }
              },
              "properties": {
                "category": "Patterns",
                "paradigms": [
                  "oop"
                ]
              }
            },
            {
              "id": "PAT102",
              "name": "Anemic Domain Model",
              "shortDescription": {
                "text": "A domain-named class with settable data and no behavior, while logic lives in services."
              },
              "fullDescription": {
                "text": "Behavior is separated from the data it belongs to."
              },
              "defaultConfiguration": {
                "level": "warning"
              },
              "messageStrings": {
                "anemic": {
                  "text": "{0} is an anemic domain object"
                },
                "setters": {
                  "text": "{0} public setters and no methods: its invariants must be enforced by whoever changes it. Plain DTOs are fine; this one sits in a domain namespace."
                }
              },
              "properties": {
                "category": "Patterns",
                "paradigms": [
                  "oop"
                ]
              }
            },
            {
              "id": "PAT103",
              "name": "Middle Man",
              "shortDescription": {
                "text": "A class that does almost nothing but forward to one collaborator, without a shared abstraction."
              },
              "fullDescription": {
                "text": "An extra hop with no value of its own."
              },
              "defaultConfiguration": {
                "level": "warning"
              },
              "messageStrings": {
                "forwards": {
                  "text": "{0} only forwards to {1}"
                },
                "single": {
                  "text": "All {0} public methods are single calls to the same member; callers could use it directly."
                }
              },
              "properties": {
                "category": "Patterns",
                "paradigms": [
                  "oop"
                ]
              }
            },
            {
              "id": "PRN001",
              "name": "Single Responsibility",
              "shortDescription": {
                "text": "Counts constructor dependencies of a class and the project modules it reaches into."
              },
              "fullDescription": {
                "text": "A class with many collaborators likely has several reasons to change."
              },
              "defaultConfiguration": {
                "level": "warning"
              },
              "messageStrings": {
                "concerns": {
                  "text": "Reaching into more than {0} modules suggests the class coordinates unrelated concerns."
                },
                "constructor": {
                  "text": "{0} takes {1} dependencies in its constructor"
                },
                "injected": {
                  "text": "More than {0} injected collaborators usually mean several responsibilities live in one class."
                },
                "modules": {
                  "text": "{0} depends on {1} other modules"
                }
              },
              "properties": {
                "category": "Principles",
                "paradigms": [
                  "oop"
                ]
              }
            },
            {
              "id": "PRN002",
              "name": "Open/Closed",
              "shortDescription": {
                "text": "Finds the same enum or tag switched on in several places."
              },
              "fullDescription": {
                "text": "Adding a value then means editing every switch."
              },
              "defaultConfiguration": {
                "level": "warning"
              },
              "messageStrings": {
                "repeats": {
                  "text": "Switch over {0} repeats at {1} sites"
                },
                "table": {
                  "text": "{0} switches dispatch on {1}; a new value needs an edit at each. A polymorphic type or a table keeps this closed for modification."
                }
              },
              "properties": {
                "category": "Principles",
                "paradigms": [
                  "oop"
                ]
              }
            },
            {
              "id": "PRN003",
              "name": "Liskov Substitution",
              "shortDescription": {
                "text": "An override or implementation whose body only throws not-supported or not-implemented."
              },
              "fullDescription": {
                "text": "Such a member cannot stand in for its base type."
              },
              "defaultConfiguration": {
                "level": "warning"
              },
              "messageStrings": {
                "rejects": {
                  "text": "{0} rejects the inherited contract"
                },
                "throws": {
                  "text": "The member exists only to throw, so code written against the base type breaks when it receives this subtype."
                }
              },
              "properties": {
                "category": "Principles",
                "paradigms": [
                  "oop"
                ]
              }
            },
            {
              "id": "PRN004",
              "name": "Interface Segregation",
              "shortDescription": {
                "text": "Interfaces with many members, or whose implementers stub some of them."
              },
              "fullDescription": {
                "text": "Clients are forced to depend on members they do not use."
              },
              "defaultConfiguration": {
                "level": "warning"
              },
              "messageStrings": {
                "onlyThrow": {
                  "text": "Implementers only throw in: {0}. The interface is wider than some clients need."
                },
                "refused": {
                  "text": "{0} has members its implementers refuse"
                },
                "roles": {
                  "text": "More than {0} members on one interface usually mix several client roles."
                },
                "wide": {
                  "text": "{0} declares {1} members"
                }
              },
              "properties": {
                "category": "Principles",
                "paradigms": [
                  "oop"
                ]
              }
            },
            {
              "id": "PRN005",
              "name": "Dependency Inversion",
              "shortDescription": {
                "text": "Creating a project class that implements a project abstraction, outside composition roots and test classes (a class with test-framework attributes such as Fact, Theory, Test, TestMethod, TestCase)."
              },
              "fullDescription": {
                "text": "The caller is bound to the concrete type."
              },
              "defaultConfiguration": {
                "level": "warning"
              },
              "messageStrings": {
                "creates": {
                  "text": "{0} creates {1} directly"
                },
                "inject": {
                  "text": "{0} is available through {1}, but {2} instantiates the concrete class. Injecting the abstraction keeps {3} replaceable and testable."
                }
              },
              "properties": {
                "category": "Principles",
                "paradigms": [
                  "oop"
                ]
              }
            },
            {
              "id": "PRN006",
              "name": "Do not repeat yourself",
              "shortDescription": {
                "text": "Callables whose structure is identical up to local names and literals."
              },
              "fullDescription": {
                "text": "One piece of knowledge is encoded twice."
              },
              "defaultConfiguration": {
                "level": "warning"
              },
              "messageStrings": {
                "duplicates": {
                  "text": "{0} has {1} structural duplicate(s)"
                },
                "same": {
                  "text": "Same statement structure and member usage, differing at most in local names and literals: {0}."
                }
              },
              "properties": {
                "category": "Principles",
                "paradigms": []
              }
            },
            {
              "id": "PRN007",
              "name": "Keep it simple",
              "shortDescription": {
                "text": "Long boolean conditions and nested ternaries."
              },
              "fullDescription": {
                "text": "Too many decisions are packed into one expression."
              },
              "defaultConfiguration": {
                "level": "warning"
              },
              "messageStrings": {
                "branching": {
                  "text": "A ternary inside a ternary hides the branching; an if or a switch expression shows it."
                },
                "intent": {
                  "text": "More than {0} operators in one condition; named intermediate values or a predicate method would state the intent."
                },
                "operators": {
                  "text": "Condition combines {0} boolean operators"
                },
                "ternary": {
                  "text": "Nested ternary expression"
                }
              },
              "properties": {
                "category": "Principles",
                "paradigms": []
              }
            },
            {
              "id": "PRN008",
              "name": "You are not going to need it",
              "shortDescription": {
                "text": "Non-public abstractions with too few implementers, and unused private parameters."
              },
              "fullDescription": {
                "text": "Generality that nothing uses."
              },
              "defaultConfiguration": {
                "level": "warning"
              },
              "messageStrings": {
                "implementers": {
                  "text": "{0} has {1} implementer(s)"
                },
                "indirection": {
                  "text": "A non-public abstraction with at most one implementation adds indirection without a second use. It may still serve test doubles, which this analysis cannot see."
                },
                "parameter": {
                  "text": "Parameter {0} of {1} is never used"
                },
                "private": {
                  "text": "The method is private, so no external contract requires this parameter."
                }
              },
              "properties": {
                "category": "Principles",
                "paradigms": []
              }
            },
            {
              "id": "PRN009",
              "name": "Law of Demeter",
              "shortDescription": {
                "text": "Call chains that walk through several distinct project types."
              },
              "fullDescription": {
                "text": "The caller is coupled to the internal structure of other types."
              },
              "defaultConfiguration": {
                "level": "warning"
              },
              "messageStrings": {
                "chain": {
                  "text": "Chain crosses {0} project types"
                },
                "navigates": {
                  "text": "The call site navigates {0}. Asking the first object for what is needed hides that structure."
                }
              },
              "properties": {
                "category": "Principles",
                "paradigms": [
                  "oop"
                ]
              }
            },
            {
              "id": "SEC001",
              "name": "Hardcoded secret (heuristic)",
              "shortDescription": {
                "text": "String literals assigned to secret-like names, and literals shaped like known credentials."
              },
              "fullDescription": {
                "text": "Not a substitute for a secret scanner."
              },
              "defaultConfiguration": {
                "level": "warning"
              },
              "messageStrings": {
                "credential": {
                  "text": "{0} holds what looks like a real credential"
                },
                "placeholder": {
                  "text": "Heuristic: the name suggests a secret and the value is a literal. It may be a placeholder or a non-secret value."
                },
                "rotate": {
                  "text": "Heuristic: the literal matches the format of a known key or token. Rotate it if it is real, and load it from a secret store."
                },
                "secret": {
                  "text": "{0} looks like a hardcoded secret"
                }
              },
              "properties": {
                "category": "Security",
                "paradigms": []
              }
            },
            {
              "id": "SEC002",
              "name": "Insecure deserialization (heuristic)",
              "shortDescription": {
                "text": "Use of formatters that instantiate arbitrary types from input, or polymorphic type handling."
              },
              "fullDescription": {
                "text": "Heuristic by shape of code, no taint analysis."
              },
              "defaultConfiguration": {
                "level": "error"
              },
              "messageStrings": {
                "arbitrary": {
                  "text": "Heuristic: this formatter can instantiate arbitrary types from its input; whether the input is trusted is not checked."
                },
                "formatter": {
                  "text": "{0} is unsafe with untrusted data"
                },
                "gadgets": {
                  "text": "Heuristic: type names read from the payload allow gadget chains unless a binder restricts them."
                },
                "typeNames": {
                  "text": "TypeNameHandling.{0} enables polymorphic deserialization"
                }
              },
              "properties": {
                "category": "Security",
                "paradigms": []
              }
            },
            {
              "id": "SEC003",
              "name": "SQL concatenation (heuristic)",
              "shortDescription": {
                "text": "SQL-looking text concatenated or interpolated with non-constant values."
              },
              "fullDescription": {
                "text": "Heuristic by shape of code, no taint analysis."
              },
              "defaultConfiguration": {
                "level": "warning"
              },
              "messageStrings": {
                "injection": {
                  "text": "Heuristic: if any value comes from a user, this allows injection. Parameterized queries keep data out of the statement."
                },
                "sql": {
                  "text": "SQL built from non-constant values"
                }
              },
              "properties": {
                "category": "Security",
                "paradigms": []
              }
            },
            {
              "id": "STR001",
              "name": "Goto",
              "shortDescription": {
                "text": "Uses of goto. Switch-case jumps are not flagged."
              },
              "fullDescription": {
                "text": "Breaks single-entry, single-exit structure of blocks."
              },
              "defaultConfiguration": {
                "level": "warning"
              },
              "messageStrings": {
                "jump": {
                  "text": "goto {0} in {1}"
                },
                "structure": {
                  "text": "The flow no longer follows the block structure; a loop, a helper or an early return usually replaces it."
                }
              },
              "properties": {
                "category": "Paradigm",
                "paradigms": [
                  "structural"
                ]
              }
            },
            {
              "id": "STR002",
              "name": "Global state",
              "shortDescription": {
                "text": "Non-private static mutable fields and properties, module-level variables."
              },
              "fullDescription": {
                "text": "Acts as a hidden global."
              },
              "defaultConfiguration": {
                "level": "warning"
              },
              "messageStrings": {
                "field": {
                  "text": "Global mutable field {0}.{1}"
                },
                "fieldShared": {
                  "text": "A non-private static mutable field is shared by all code and threads."
                },
                "history": {
                  "text": "Any function can change it, so its value depends on the call history."
                },
                "property": {
                  "text": "Global mutable property {0}.{1}"
                },
                "propertyShared": {
                  "text": "A static settable property is shared by all code and threads."
                },
                "variable": {
                  "text": "Global variable {0}"
                }
              },
              "properties": {
                "category": "Paradigm",
                "paradigms": [
                  "structural"
                ]
              }
            },
            {
              "id": "STR003",
