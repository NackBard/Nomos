{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:nomos:contracts:1.0.0:practice",
  "title": "Practice catalog",
  "description": "Schema of spec/practices.yaml (validated after YAML-to-JSON conversion): named sets of rules that `practices` in nomos.json selects. Contract version 1.0.0.",
  "x-contractVersion": "1.0.0",
  "type": "object",
  "required": ["schemaVersion", "practices"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "practices": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "title", "description", "rules"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
          "title": { "type": "string", "minLength": 1 },
          "description": { "type": "string", "minLength": 1, "description": "What the practice looks at." },
          "rules": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "type": "string", "pattern": "^([A-Z]{2,3}\\.)?[A-Z]{2,4}[0-9]{3}$" },
            "description": "Rule ids of spec/rules. A rule may belong to several practices; every rule belongs to at least one."
          }
        }
      }
    }
  }
}
