{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:nomos:contracts:1.1.0:practice",
  "title": "Practice catalog",
  "description": "Schema of spec/practices.yaml (validated after YAML-to-JSON conversion): named sets of rules that `practices` in nomos.json selects. Contract version 1.1.0: l10n is optional (D-052).",
  "x-contractVersion": "1.1.0",
  "type": "object",
  "required": ["schemaVersion", "practices"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "enum": ["1.0.0", "1.1.0"], "description": "Minor versions only add optional fields, so files of older minor versions stay valid." },
    "practices": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "title", "description", "rules"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
          "title": { "type": "string", "minLength": 1 },
          "description": { "type": "string", "minLength": 1, "description": "What the practice looks at." },
          "rules": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "type": "string", "pattern": "^([A-Z]{2,3}\\.)?[A-Z]{2,4}[0-9]{3}$" },
            "description": "Rule ids of spec/rules. A rule may belong to several practices; every rule belongs to at least one."
          },
          "l10n": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "ru": {
                "type": "object",
                "required": ["title", "description"],
                "additionalProperties": false,
                "properties": { "title": { "type": "string", "minLength": 1 }, "description": { "type": "string", "minLength": 1 } }
              }
            },
            "description": "Texts of the practice in other languages, keyed by language (spec/l10n.md)."
          }
        }
      }
    }
  }
}
