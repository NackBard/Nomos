{
  "name": "nomos",
  "displayName": "Nomos",
  "description": "%description%",
  "version": "0.1.2",
  "publisher": "honestarchitector",
  "repository": {
    "type": "git",
    "url": "https://github.com/NackBard/Nomos.git"
  },
  "private": true,
  "license": "MIT",
  "icon": "media/icon-128-min.png",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Linters",
    "Visualization"
  ],
  "main": "./out/extension.js",
  "activationEvents": [
    "workspaceContains:nomos.json"
  ],
  "contributes": {
    "commands": [
      {
        "command": "nomos.analyze",
        "title": "%command.analyze%",
        "icon": "$(play)",
        "category": "Nomos"
      },
      {
        "command": "nomos.showGraph",
        "title": "%command.showGraph%",
        "icon": "$(type-hierarchy)",
        "category": "Nomos"
      },
      {
        "command": "nomos.openGraphWindow",
        "title": "%command.openGraphWindow%",
        "icon": "$(empty-window)",
        "category": "Nomos"
      },
      {
        "command": "nomos.choosePractices",
        "title": "%command.choosePractices%",
        "icon": "$(checklist)",
        "category": "Nomos"
      },
      {
        "command": "nomos.settings",
        "title": "%command.settings%",
        "icon": "$(settings-gear)",
        "category": "Nomos"
      },
      {
        "command": "nomos.exportClassDiagram",
        "title": "%command.exportClassDiagram%",
        "icon": "$(export)",
        "category": "Nomos"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "nomos",
          "title": "Nomos",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "nomos": [
        {
          "id": "nomos.findings",
          "name": "%view.findings%"
        },
        {
          "id": "nomos.paradigms",
          "name": "%view.paradigms%",
          "visibility": "collapsed"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "nomos.findings",
        "contents": "%welcome.findings%",
        "when": "!nomos.analyzed"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "nomos.analyze",
          "when": "view == nomos.findings",
          "group": "navigation"
        },
        {
          "command": "nomos.showGraph",
          "when": "view == nomos.findings",
          "group": "navigation"
        },
        {
          "command": "nomos.choosePractices",
          "when": "view == nomos.findings",
          "group": "navigation"
        },
        {
          "command": "nomos.settings",
          "when": "view == nomos.findings",
          "group": "navigation"
        }
      ],
      "editor/title": [
        {
          "command": "nomos.openGraphWindow",
          "when": "activeWebviewPanelId == nomos.graph",
          "group": "navigation"
        },
        {
          "command": "nomos.exportClassDiagram",
          "when": "activeWebviewPanelId == nomos.graph",
          "group": "navigation"
        }
      ]
    },
    "configuration": {
      "title": "Nomos",
      "properties": {
        "nomos.analyzeOnSave": {
          "type": "boolean",
          "default": false,
          "description": "%config.analyzeOnSave%"
        },
        "nomos.codeLens": {
          "type": "boolean",
          "default": true,
          "description": "%config.codeLens%"
        },
        "nomos.diagnostics": {
          "type": "string",
          "enum": [
            "hint",
            "information",
            "level",
            "off"
          ],
          "enumDescriptions": [
            "%config.diagnostics.hint%",
            "%config.diagnostics.information%",
            "%config.diagnostics.level%",
            "%config.diagnostics.off%"
          ],
          "default": "hint",
          "description": "%config.diagnostics%"
        },
        "nomos.practices": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "string"
          },
          "uniqueItems": true,
          "default": null,
          "scope": "resource",
          "markdownDescription": "%config.practices%"
        }
      }
    }
  },
  "scripts": {
    "compile": "node scripts/copy-contracts.mjs && tsc -p .",
    "vscode:prepublish": "npm run compile",
    "package": "node scripts/package.mjs",
    "test": "npm run compile && node --test \"out/test/**/*.test.js\"",
    "e2e": "npm run compile && node scripts/run-e2e.mjs",
    "check-boundary": "node scripts/check-boundary.mjs",
    "check-l10n": "node scripts/check-l10n.mjs"
  },
  "dependencies": {
    "ajv": "8.20.0"
  },
  "devDependencies": {
    "@types/node": "24.3.0",
    "@types/vscode": "1.90.0",
    "@vscode/vsce": "4.0.0",
    "typescript": "5.9.2"
  },
  "l10n": "./l10n"
}
