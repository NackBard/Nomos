{
  "schemaVersion": "1.0.0",
  "analyzers": [
    {
      "language": "csharp",
      "command": ["dotnet", "run", "--project", "analyzers/csharp/src/Nomos.Analyzer.CSharp", "-v", "q", "--"],
      "exclude": ["analyzers/csharp/tests/**", "conformance/**", "**/node_modules/**"]
    }
  ],
  "layers": [
    { "name": "Contracts", "patterns": ["Nomos.Abstractions*"], "mayDependOn": [] },
    { "name": "Platform", "patterns": ["Nomos.Core*", "Nomos.Graph*", "Nomos.Facts*", "Nomos.Reporting*"], "mayDependOn": ["Contracts"] },
    { "name": "Detectors", "patterns": ["Nomos.Analyzers*", "Nomos.Languages*"], "mayDependOn": ["Contracts", "Platform"] },
    { "name": "Host", "patterns": ["Nomos.Analyzer.CSharp*"], "mayDependOn": ["Contracts", "Platform", "Detectors"] }
  ]
}
