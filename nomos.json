{
  "schemaVersion": "1.1.0",
  "analyzers": [
    {
      "language": "csharp",
      "command": [
        "dotnet",
        "run",
        "--project",
        "analyzers/csharp/src/Nomos.Analyzer.CSharp",
        "-v",
        "q",
        "--"
      ],
      "exclude": [
        "analyzers/csharp/tests/**",
        "conformance/**",
        "**/node_modules/**"
      ]
    },
    {
      "language": "go",
      "command": [
        "go",
        "run",
        "nomos/analyzers/go/cmd/nomos-go"
      ],
      "exclude": [
        "conformance/**",
        "**/node_modules/**"
      ]
    },
    {
      "language": "typescript",
      "command": [
        "node",
        "analyzers/typescript/src/main.ts"
      ],
      "exclude": [
        "conformance/**",
        "**/node_modules/**",
        "extension/bundle/**"
      ]
    },
    {
      "language": "javascript",
      "command": [
        "node",
        "analyzers/typescript/src/main.ts",
        "--language",
        "javascript"
      ],
      "exclude": [
        "conformance/**",
        "**/node_modules/**",
        "extension/bundle/**"
      ]
    },
    {
      "language": "python",
      "command": [
        "node",
        "analyzers/python/run.mjs"
      ],
      "exclude": [
        "conformance/**",
        "**/node_modules/**",
        "extension/bundle/**"
      ]
    },
    {
      "language": "java",
      "command": [
        "node",
        "analyzers/java/run.mjs"
      ],
      "exclude": [
        "conformance/**",
        "**/node_modules/**",
        "extension/bundle/**"
      ]
    }
  ],
  "layers": [
    {
      "name": "Contracts",
      "patterns": [
        "Nomos.Abstractions*"
      ],
      "mayDependOn": []
    },
    {
      "name": "Platform",
      "patterns": [
        "Nomos.Core*",
        "Nomos.Graph*",
        "Nomos.Facts*",
        "Nomos.Reporting*"
      ],
      "mayDependOn": [
        "Contracts"
      ]
    },
    {
      "name": "Detectors",
      "patterns": [
        "Nomos.Analyzers*",
        "Nomos.Languages*"
      ],
      "mayDependOn": [
        "Contracts",
        "Platform"
      ]
    },
    {
      "name": "Host",
      "patterns": [
        "Nomos.Analyzer.CSharp*"
      ],
      "mayDependOn": [
        "Contracts",
        "Platform",
        "Detectors"
      ]
    }
  ],
  "practices": [
    "simplicity",
    "oop",
    "functional",
    "structural",
    "architecture",
    "maintainability",
    "performance",
    "patterns",
    "security"
  ]
}
